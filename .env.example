# Create a free Sanity project, then paste values here.
NEXT_PUBLIC_SANITY_PROJECT_ID=g32xvgua
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Used by /api/revalidate (Sanity webhook → on-demand ISR).
# Generate a long random value. Empty = endpoint always returns 401 (fail closed).
# Never commit the real secret.
SANITY_REVALIDATE_SECRET= 

# Public site URL (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.officialnoragroup.com

# Public content repository. Server-only — never NEXT_PUBLIC_*.
# sanity = current production path (Sanity + seed fallback).
# postgres = future CMS (not implemented; falls back to Sanity with a warning).
# Missing or any other value is treated as sanity.
CONTENT_SOURCE=sanity

# PostgreSQL (Prisma). Leave empty on Vercel production until a later phase.
# DATABASE_URL = pooled connection (app). DATABASE_URL_UNPOOLED = direct (migrations).
# Phase 2: local or dedicated staging only. Never point these at production.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# First-party Dashboard sessions (unused until auth is implemented). 32+ random bytes.
AUTH_SECRET=
