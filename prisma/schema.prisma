// Nora Group — PostgreSQL schema (Phase 1 foundations).
//
// NOT APPLIED. No migrate, no production connection, no seed data.
// Public website continues to read Sanity via getSiteContent().
//
// This file models the future CMS so it can map 1:1 onto SiteContent
// (lib/content/types.ts). Legal pages and the lazaCore "madeBy" string stay in code.
// Image binaries are never stored here — only media metadata + public URLs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Locale {
  he
  ar
  en
  ru
}

enum RoleKey {
  super_admin
  admin
  editor
  translator
  viewer
}

enum PublishStatus {
  draft
  published
  archived
}

enum ProjectCategory {
  kitchens
  bedrooms
  wardrobes
  furniture
  commercial
}

enum MediaPlacement {
  primary
  gallery
}

// ---------------------------------------------------------------------------
// Auth — first-party sessions, Argon2id hashes (application layer, later).
// One role per user. Sessions store token_hash only, never the raw cookie.
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  key         RoleKey          @unique
  name        String
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  name          String
  /// Argon2id hash. Never return this field from API or client modules.
  passwordHash  String               @map("password_hash")
  roleId        String               @map("role_id")
  role          Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive      Boolean              @default(true) @map("is_active")
  lastLoginAt   DateTime?            @map("last_login_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  uploadedMedia Media[]

  @@index([roleId])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session cookie value. Never store the raw token.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_user_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Media — object storage metadata only. No BYTEA / binaries.
// ---------------------------------------------------------------------------

model Media {
  id           String             @id @default(uuid())
  storageKey   String             @unique @map("storage_key")
  publicUrl    String             @map("public_url")
  mimeType     String             @map("mime_type")
  byteSize     Int                @map("byte_size")
  width        Int?
  height       Int?
  blurhash     String?
  uploadedById String?            @map("uploaded_by")
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  translations MediaTranslation[]

  siteLogo            SiteSettings[] @relation("SiteLogo")
  siteLogoDark        SiteSettings[] @relation("SiteLogoDark")
  siteQr              SiteSettings[] @relation("SiteQr")
  siteSeoImage        SiteSettings[] @relation("SiteSeoImage")
  homeSeoImage        HomePage[]     @relation("HomeSeoImage")
  heroSlides          HeroSlide[]
  aboutImage          AboutPage[]    @relation("AboutImage")
  aboutSeoImage       AboutPage[]    @relation("AboutSeoImage")
  howWeWorkImage      HowWeWorkPage[] @relation("HowWeWorkImage")
  howWeWorkSeoImage   HowWeWorkPage[] @relation("HowWeWorkSeoImage")
  howWeWorkStepImages HowWeWorkStep[]
  contactImage        ContactPage[]  @relation("ContactImage")
  contactSeoImage     ContactPage[]  @relation("ContactSeoImage")
  faqImage            FaqPage[]      @relation("FaqImage")
  faqSeoImage         FaqPage[]      @relation("FaqSeoImage")
  blogPageImage       BlogPage[]     @relation("BlogPageImage")
  blogPageSeoImage    BlogPage[]     @relation("BlogPageSeoImage")
  serviceImages       ServiceImage[]
  serviceSeoImages    Service[]      @relation("ServiceSeoImage")
  projectImages       ProjectImage[]
  projectSeoImages    Project[]      @relation("ProjectSeoImage")
  materialImages      Material[]     @relation("MaterialImage")
  testimonialImages   Testimonial[]  @relation("TestimonialImage")
  blogPostImages      BlogPost[]     @relation("BlogPostImage")
  blogPostSeoImages   BlogPost[]     @relation("BlogPostSeoImage")

  @@map("media")
}

model MediaTranslation {
  id      String @id @default(uuid())
  mediaId String @map("media_id")
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  locale  Locale
  alt     String @default("")

  @@unique([mediaId, locale])
  @@map("media_translations")
}

