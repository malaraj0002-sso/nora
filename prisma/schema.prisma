model BlogPost {
  id              String                 @id @default(uuid())
  slug            String                 @unique
  category        String                 @default("")
  author          String                 @default("Nora Group")
  date            DateTime?              @db.Date
  tags            String[]
  visible         Boolean                @default(true)
  featured        Boolean                @default(false)
  status          PublishStatus          @default(draft)
  publishedAt     DateTime?              @map("published_at")
  imageMediaId    String?                @map("image_media_id")
  imageMedia      Media?                 @relation("BlogPostImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  seoImageMediaId String?                @map("seo_image_media_id")
  seoImageMedia   Media?                 @relation("BlogPostSeoImage", fields: [seoImageMediaId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  translations    BlogPostTranslation[]

  @@index([visible, date])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id             String   @id @default(uuid())
  blogPostId     String   @map("blog_post_id")
  blogPost       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String   @default("")
  excerpt        String   @default("")
  content        String   @default("")
  seoTitle       String   @default("") @map("seo_title")
  seoDescription String   @default("") @map("seo_description")

  @@unique([blogPostId, locale])
  @@map("blog_post_translations")
}
