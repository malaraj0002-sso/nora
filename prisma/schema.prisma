  mapUrl          String?                   @map("map_url")
  logoMediaId     String?                   @map("logo_media_id")
  logoMedia       Media?                    @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  logoDarkMediaId String?                   @map("logo_dark_media_id")
  logoDarkMedia   Media?                    @relation("SiteLogoDark", fields: [logoDarkMediaId], references: [id], onDelete: SetNull)
  qrMediaId       String?                   @map("qr_media_id")
