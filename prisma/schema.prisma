  subtitle       String   @default("")
  seoTitle       String   @default("") @map("seo_title")
  seoDescription String   @default("") @map("seo_description")

  @@unique([blogPageId, locale])
  @@map("blog_page_translations")
}

// ---------------------------------------------------------------------------
// Catalog — services (seven golden slugs are is_locked; no rows inserted here)
// ---------------------------------------------------------------------------

model Service {
  id              String                 @id @default(uuid())
  slug            String                 @unique
  sortOrder       Int                    @default(0) @map("sort_order")
  visible         Boolean                @default(true)
  featured        Boolean                @default(false)
  status          PublishStatus          @default(draft)
  /// Golden seven: kitchens, bedrooms, wardrobes, walk-in-closets,
  /// custom-furniture, offices, commercial. App + future DB trigger must
  /// refuse DELETE and slug UPDATE when true. Do not insert those rows in Phase 1.
  isLocked        Boolean                @default(false) @map("is_locked")
  publishedAt     DateTime?              @map("published_at")
  seoImageMediaId String?                @map("seo_image_media_id")
  seoImageMedia   Media?                 @relation("ServiceSeoImage", fields: [seoImageMediaId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  translations    ServiceTranslation[]
  features        ServiceFeature[]
  images          ServiceImage[]
  featuredOnHome  HomeFeaturedService[]

  @@index([visible, sortOrder])
  @@index([isLocked])
  @@map("services")
}

model ServiceTranslation {
  id             String  @id @default(uuid())
  serviceId      String  @map("service_id")
  service        Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String  @default("")
  description    String  @default("")
  body           String  @default("")
  seoTitle       String  @default("") @map("seo_title")
  seoDescription String  @default("") @map("seo_description")

  @@unique([serviceId, locale])
  @@map("service_translations")
}

model ServiceFeature {
  id           String                         @id @default(uuid())
  serviceId    String                         @map("service_id")
  service      Service                        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sortOrder    Int                            @default(0) @map("sort_order")
  translations ServiceFeatureTranslation[]

  @@index([serviceId, sortOrder])
  @@map("service_features")
}

model ServiceFeatureTranslation {
  id        String         @id @default(uuid())
  featureId String         @map("feature_id")
  feature   ServiceFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  locale    Locale
  title     String         @default("")

  @@unique([featureId, locale])
  @@map("service_feature_translations")
}

model ServiceImage {
  id        String         @id @default(uuid())
  serviceId String         @map("service_id")
  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mediaId   String         @map("media_id")
  media     Media          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  placement MediaPlacement @default(gallery)
  sortOrder Int            @default(0) @map("sort_order")

  @@index([serviceId, placement, sortOrder])
  @@map("service_images")
}

model Project {
  id              String                  @id @default(uuid())
  slug            String                  @unique
  category        ProjectCategory
  completedAt     DateTime?               @map("completed_at") @db.Date
  sortOrder       Int                     @default(0) @map("sort_order")
  visible         Boolean                 @default(true)
  featured        Boolean                 @default(false)
  status          PublishStatus           @default(draft)
  publishedAt     DateTime?               @map("published_at")
  seoImageMediaId String?                 @map("seo_image_media_id")
  seoImageMedia   Media?                  @relation("ProjectSeoImage", fields: [seoImageMediaId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  translations    ProjectTranslation[]
  images          ProjectImage[]
  materials       ProjectMaterial[]
  featuredOnHome  HomeFeaturedProject[]

  @@index([visible, category])
  @@map("projects")
}

model ProjectTranslation {
  id             String  @id @default(uuid())
  projectId      String  @map("project_id")
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String  @default("")
  description    String  @default("")
  location       String  @default("")
  seoTitle       String  @default("") @map("seo_title")
  seoDescription String  @default("") @map("seo_description")

  @@unique([projectId, locale])
  @@map("project_translations")
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String  @map("media_id")
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int     @default(0) @map("sort_order")

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model ProjectMaterial {
  projectId  String   @map("project_id")
  materialId String   @map("material_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([projectId, materialId])
  @@map("project_materials")
}

model Material {
  id           String                  @id @default(uuid())
  slug         String                  @unique
  category     String?
  sortOrder    Int                     @default(0) @map("sort_order")
  visible      Boolean                 @default(true)
  featured     Boolean                 @default(false)
  status       PublishStatus           @default(draft)
  publishedAt  DateTime?               @map("published_at")
  imageMediaId String?                 @map("image_media_id")
  imageMedia   Media?                  @relation("MaterialImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  translations MaterialTranslation[]
  projects     ProjectMaterial[]

  @@index([visible, sortOrder])
  @@map("materials")
}

model MaterialTranslation {
  id               String   @id @default(uuid())
  materialId       String   @map("material_id")
  material         Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String   @default("")
  description      String   @default("")
  characteristics  String   @default("")
  applications     String   @default("")
  finishes         String   @default("")

  @@unique([materialId, locale])
  @@map("material_translations")
}

model Testimonial {
  id           String                     @id @default(uuid())
  /// Display name is not localized (matches current SiteContent / Sanity).
  name         String
  rating       Int                        @default(5)
  sortOrder    Int                        @default(0) @map("sort_order")
  visible      Boolean                    @default(true)
  featured     Boolean                    @default(false)
  status       PublishStatus              @default(draft)
  publishedAt  DateTime?                  @map("published_at")
  imageMediaId String?                    @map("image_media_id")
  imageMedia   Media?                     @relation("TestimonialImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  translations TestimonialTranslation[]

  @@index([visible, sortOrder])
  @@map("testimonials")
}

model TestimonialTranslation {
  id            String      @id @default(uuid())
  testimonialId String      @map("testimonial_id")
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  locale        Locale
  review        String      @default("")
  project       String      @default("")

  @@unique([testimonialId, locale])
  @@map("testimonial_translations")
}

model FaqItem {
  id           String                  @id @default(uuid())
  category     String                  @default("")
  sortOrder    Int                     @default(0) @map("sort_order")
  visible      Boolean                 @default(true)
  status       PublishStatus           @default(draft)
  publishedAt  DateTime?               @map("published_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  translations FaqItemTranslation[]

  @@index([visible, sortOrder])
  @@map("faq_items")
}

model FaqItemTranslation {
  id        String  @id @default(uuid())
  faqItemId String  @map("faq_item_id")
  faqItem   FaqItem @relation(fields: [faqItemId], references: [id], onDelete: Cascade)
  locale    Locale
  question  String  @default("")
  answer    String  @default("")

